<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Add the "PDF Preview" widget to the invoice form, right after the
        standard Print button.  The widget name maps to the OWL component
        registered in the `view_widgets` registry.
    -->
    <record id="view_move_form_invoice_preview" model="ir.ui.view">
        <field name="name">account.move.form.invoice.preview</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_print_pdf']" position="after">
                <widget
                    name="invoice_preview_button"
                    invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')"
                />
            </xpath>
        </field>
    </record>
</odoo>
