<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="account_invoice_preview.InvoicePreviewPanel">
        <button
            t-on-click="togglePreview"
            t-att-class="'btn o_invoice_preview_toggle_btn ' + (state.visible ? 'btn-primary' : 'btn-secondary')"
            t-att-title="state.visible ? _t('Close preview') : _t('Live PDF preview')"
        >
            <i t-att-class="'fa ' + (state.visible ? 'fa-eye-slash' : 'fa-eye')" aria-hidden="true"/>
            <span t-if="!state.visible">
                <t t-esc="_t('PDF Preview')"/>
            </span>
            <span t-if="state.visible">
                <t t-esc="_t('Close Preview')"/>
            </span>
        </button>
        <div t-if="state.visible" class="o_invoice_preview_panel">
            <div class="o_invoice_preview_panel_header">
                <span class="o_invoice_preview_panel_title">
                    <i class="fa fa-file-pdf-o me-2" aria-hidden="true"/>
                    <t t-esc="_t('Invoice Preview')"/>
                </span>
                <div class="o_invoice_preview_panel_actions">
                    <button
                        class="btn btn-sm btn-outline-primary"
                        t-on-click="refreshPreview"
                        t-att-title="_t('Refresh the PDF')"
                        t-att-disabled="state.loading ? 'disabled' : false"
                    >
                        <i t-att-class="'fa fa-refresh ' + (state.loading ? 'fa-spin' : '')" aria-hidden="true"/>
                        <span class="ms-1">
                            <t t-esc="_t('Refresh')"/>
                        </span>
                    </button>
                    <button
                        class="btn btn-sm btn-outline-secondary ms-2"
                        t-on-click="closePreview"
                        t-att-title="_t('Close panel')">
                        <i class="fa fa-times" aria-hidden="true"/>
                    </button>
                </div>
            </div>
            <div t-if="state.loading" class="o_invoice_preview_loading">
                <div class="o_invoice_preview_spinner">
                    <i class="fa fa-spinner fa-spin fa-3x" aria-hidden="true"/>
                    <p class="mt-3">
                        <t t-esc="_t('Generating PDF…')"/>
                    </p>
                </div>
            </div>
            <div t-if="state.error and !state.loading" class="o_invoice_preview_error">
                <i class="fa fa-exclamation-triangle fa-2x text-warning" aria-hidden="true"/>
                <p class="mt-2">
                    <t t-esc="state.error"/>
                </p>
                <button class="btn btn-sm btn-primary mt-2" t-on-click="refreshPreview">
                    <t t-esc="_t('Retry')"/>
                </button>
            </div>
            <iframe
                t-if="state.pdfUrl"
                t-att-src="state.pdfUrl"
                class="o_invoice_preview_iframe"
                t-att-style="state.loading ? 'opacity:0;' : 'opacity:1;'"
                frameborder="0"
                t-on-load="onIframeLoad"
                t-on-error="onIframeError"
                allowfullscreen="true"
            />
        </div>
    </t>
</templates>