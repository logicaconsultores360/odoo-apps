<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view: insert Draft Invoicing before Companys fiesld -->
    <record id="sale_subscription_plan_view_form_draft_invoicing" model="ir.ui.view">
        <field name="name">sale.subscription.plan.form.draft_invoicing</field>
        <field name="model">sale.subscription.plan</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_plan_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="before">
                <field name="draft_invoicing"/>
            </xpath>
        </field>
    </record>

    <!-- List view: insert Draft Invoicing before Auto-close display column -->
    <record id="sale_subscription_plan_view_list_draft_invoicing" model="ir.ui.view">
        <field name="name">sale.subscription.plan.list.draft_invoicing</field>
        <field name="model">sale.subscription.plan</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_plan_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='auto_close_limit_display']" position="before">
                <field name="draft_invoicing"/>
            </xpath>
        </field>
    </record>

</odoo>
